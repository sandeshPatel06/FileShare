# Copy to .env.local for local development.
NEXT_PUBLIC_APP_URL=https://filesp.pages.dev
NEXT_PUBLIC_DEFAULT_THEME=system
JWT_SECRET=replace-with-a-random-local-secret
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,0.0.0.0,filesp.pages.dev

# TiDB Cloud / PostgreSQL
DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=require

# Backblaze B2 Object Storage (Optional: leave unset to use local ./uploads/)
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=us-east-005

# Google AdSense Slots (filesp.pages.dev)
NEXT_PUBLIC_ADS_SLOT_GUIDE=6198869307
NEXT_PUBLIC_ADS_SLOT_ABOUT=1524080945
NEXT_PUBLIC_ADS_SLOT_ARTICLE=7927331059
